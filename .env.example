# Homelab Secrets & Environment Template
# Copy to .env (chmod 600 .env) and fill in values as needed.
# .env and secrets/*.env are gitignored and never committed.

# ==============================================================================
# 1. Global Homelab Defaults (Optional)
# ==============================================================================
HOMELAB_DOMAIN=lab.local
DEFAULT_SSH_USER=
DNS_SERVER=

# ==============================================================================
# 2. Dynamic Service Credentials Convention
# ==============================================================================
# For ANY service registered in `inventory/services.tsv` with ID `<service-id>`,
# scripts and agents resolve credentials using uppercase `<SERVICE_ID>_*`
# (hyphens converted to underscores), or from `secrets/<service-id>.env`:
#
#   <SERVICE_ID>_URL=https://...
#   <SERVICE_ID>_API_KEY=...
#   <SERVICE_ID>_TOKEN=...
#   <SERVICE_ID>_USER=...
#   <SERVICE_ID>_PASSWORD=...
#
# Tip: Run `./scripts/hl-inventory.sh add-service <id> ... --with-env`
# to automatically append a template block for a new service below.
